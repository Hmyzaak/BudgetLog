          <mxGeometry x="1170" y="100" width="160" height="190" as="geometry" />
        </mxCell>
        <mxCell id="v46" value="&lt;div style=&quot;font-size:16px;font-weight:bold;text-align:center&quot;&gt;Transaction&lt;/div&gt;&lt;div style=&quot;font-size:11px;text-align:center;color:#666&quot;&gt;Příjem/výdaj; výdaj vrací záporné znaménko&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:12px;line-height:1.4&quot;&gt;+ id: int&lt;br&gt;+ amount: Decimal(10,2)&lt;br&gt;+ type: income | expense&lt;br&gt;+ datestamp: date&lt;br&gt;+ description: text [0..1]&lt;br&gt;+ book: Book&lt;br&gt;+ category: Category [0..1]&lt;br&gt;+ tags: Tag [0..*]&lt;hr/&gt;&lt;b&gt;+ adjusted_amount: Decimal&lt;/b&gt; {property}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
