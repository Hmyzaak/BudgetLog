        <mxCell id="0x1N-3es7ztoQ82pJybC-70" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;◆ kompozice (on_delete = CASCADE)&lt;br&gt;→ navigovatelná asociace&lt;br&gt;/ odvozený atribut (property)&lt;br&gt;podtržené = statické" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="980" y="92" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="0x1N-3es7ztoQ82pJybC-71" value="&lt;b style=&quot;font-size:18px&quot;&gt;BudgetLog – Doménový model (Class Diagram)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="10" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="CjdEi0nYyJ7e2GLkxk7p-1" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Doménová pravidla&lt;/b&gt;&lt;br style=&quot;&quot;&gt;• Každá kniha má právě jednoho vlastníka.&lt;br style=&quot;&quot;&gt;• Název knihy je unikátní v rámci vlastníka.&lt;br style=&quot;&quot;&gt;• Kategorie a tag jsou unikátní v rámci knihy.&lt;br style=&quot;&quot;&gt;• Při vytvoření knihy vzniká kategorie „Nezařazeno“.&lt;br style=&quot;&quot;&gt;• Kategorie u transakce je volitelná; tagy tvoří vazbu M:N.&lt;/font&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=11;verticalAlign=top;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1230" y="92" width="280" height="128" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
