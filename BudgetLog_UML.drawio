        <mxCell id="v42" value="&lt;div style=&quot;font-size:16px;font-weight:bold;text-align:center&quot;&gt;AppUser&lt;/div&gt;&lt;div style=&quot;font-size:11px;text-align:center;color:#666&quot;&gt;extends AbstractBaseUser&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:12px;line-height:1.4&quot;&gt;&lt;b&gt;+ email: EmailField&lt;/b&gt;&lt;br&gt;+ password: inherited&lt;br&gt;+ is_admin: bool&lt;br&gt;+ is_active: bool&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="150" y="100" width="160" height="190" as="geometry" />
        </mxCell>
        <mxCell id="v43" value="&lt;div style=&quot;font-size:16px;font-weight:bold;text-align:center&quot;&gt;Book&lt;/div&gt;&lt;div style=&quot;font-size:11px;text-align:center;color:#666&quot;&gt;Unique(name, owner) · obecný pracovní prostor&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:12px;line-height:1.4&quot;&gt;+ id: int&lt;br&gt;+ name: str&lt;br&gt;+ description: text [0..1]&lt;br&gt;+ owner: AppUser&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
