        </mxCell>
        <mxCell id="0x1N-3es7ztoQ82pJybC-67" value="{unique (name, book)}&lt;br&gt;Signál pre_delete: transakce mazané kategorie se přeřadí do výchozí kategorie (is_default).&lt;br&gt;Smazání výchozí kategorie blokuje CategoryDeleteView (HTTP 403)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="520" y="880" width="300" height="80" as="geometry" />
