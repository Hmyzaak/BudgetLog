  <diagram id="classdiagram" name="02 – Class Diagram">
    <mxGraphModel dx="1292" dy="805" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0">
