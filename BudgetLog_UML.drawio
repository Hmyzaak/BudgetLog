        <mxCell id="0x1N-3es7ztoQ82pJybC-66" value="{unique (name, owner)}&lt;br&gt;on_delete = CASCADE: smazání AppUser smaže jeho knihy (kompozice).&lt;br&gt;&lt;br&gt;Signál post_save(created = True): při vytvoření Book se vytvoří Category „Nezařazeno“ s is_default = True." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
